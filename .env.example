# ==============================================================================
# Lyftr AI — Environment Configuration
# Copy this file to .env and fill in real API keys before running.
# NEVER commit real API keys to version control.
# ==============================================================================

# Backend Configuration
# Comma-separated pool of at least 2 API keys (mapped to key_1, key_2, ... in order)
LLM_API_KEYS=your-primary-api-key-here,your-secondary-api-key-here

# Default LiteLLM model name (e.g., gemini/gemini-2.0-flash, openai/gpt-4o-mini, groq/llama-3.3-70b-versatile)
LLM_MODEL=gemini/gemini-2.0-flash

# Optional: comma-separated per-key LiteLLM model names matching LLM_API_KEYS order
# Leave empty to use LLM_MODEL for all keys
LLM_MODELS=

# SQLite database URL (in Docker, /data is backed by a named volume)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable X-Simulate-Failure header for testing automatic key failover (true/false)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM built-in response caching (true/false)
CACHE_ENABLED=true
CACHE_TYPE=local

# Optional tuning
DEFAULT_SYSTEM_PROMPT=You are Lyftr AI, a helpful, accurate, and concise assistant.
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.7
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_URL=http://localhost:8000
